# 全屋定制客户服务AI助手 - 环境变量配置示例
# 复制此文件为 .env 并填写实际配置

# ==========================================
# 数据库配置 (Supabase)
# ==========================================
# 在 Supabase 项目设置 > API 中获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# ==========================================
# AI服务配置 (MIMO大模型)
# ==========================================
# 在小米MIMO平台获取: https://xiaomimimo.com
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2-pro

# ==========================================
# 应用配置
# ==========================================
# 密钥生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# 调试模式 (true/false)
DEBUG=false

# 会话超时时间 (秒)
SESSION_TIMEOUT=3600

# 文件上传限制 (字节)
MAX_UPLOAD_SIZE=10485760

# 允许的图片类型
ALLOWED_IMAGE_TYPES=.png,.jpg,.jpeg,.webp

# ==========================================
# 性能配置
# ==========================================
# 数据库超时时间 (秒)
DB_TIMEOUT=30

# 数据库重试次数
DB_MAX_RETRIES=3

# AI请求超时时间 (秒)
AI_TIMEOUT=60

# AI最大token数
AI_MAX_TOKENS=4096

# AI温度参数 (0.0-1.0)
AI_TEMPERATURE=0.6

# 缓存过期时间 (秒)
CACHE_TTL=3600

# ==========================================
# 功能开关
# ==========================================
# 启用AI分析 (true/false)
ENABLE_AI_ANALYSIS=true

# 启用图片上传 (true/false)
ENABLE_IMAGE_UPLOAD=true

# 启用数据导出 (true/false)
ENABLE_DATA_EXPORT=true

# ==========================================
# 日志配置
# ==========================================
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/app.log

# 是否启用文件日志 (true/false)
ENABLE_FILE_LOGGING=false

# ==========================================
# 安全配置
# ==========================================
# 允许的文件扩展名
ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.webp,.pdf

# 最大请求频率 (每分钟)
RATE_LIMIT_PER_MINUTE=60

# ==========================================
# UI配置
# ==========================================
# 默认主题 (light/dark/system)
DEFAULT_THEME=system

# 页面标题
APP_TITLE=BINK不锈钢定制 · AI客户服务助手

# 每页显示记录数
PAGE_SIZE=20

# ==========================================
# 第三方集成
# ==========================================
# Sentry DSN (错误追踪)
# SENTRY_DSN=https://your-sentry-dsn

# Google Analytics ID
# GOOGLE_ANALYTICS_ID=GA-XXXXXXXXXX

# ==========================================
# 自定义配置
# ==========================================
# 公司名称
COMPANY_NAME=BINK不锈钢定制

# 默认货币
DEFAULT_CURRENCY=CNY

# 时区
TIMEZONE=Asia/Shanghai
